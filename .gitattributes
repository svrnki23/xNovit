# Check out every text file with LF line endings, on Windows and Mac alike.
# Git still stores LF in the repo. Plain `text=auto` would give Windows
# checkouts CRLF, which makes `npm run format:check` fail there; every
# editor we use handles LF fine.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
