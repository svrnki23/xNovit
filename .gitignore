# --- Dependencies (regenerated by npm install, never commit) ---
node_modules/

# --- Environment secrets (each person keeps their own, only .env.example is shared) ---
.env
.env.local

# --- Build output / logs ---
dist/
build/
*.log

# --- macOS ---
.DS_Store

# --- Xcode (for when the iOS app exists) ---
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/
Pods/

# --- Android / Gradle (for when the Android app exists) ---
.gradle/
local.properties
*.iml
.idea/

# --- Expo / React Native (for when the app project exists) ---
.expo/
