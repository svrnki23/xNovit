# Copy this file to apps/api/.env and fill in what you have. Never commit .env.
# An empty value turns that feature off; the API still starts without it.

PORT=3000
NODE_ENV=development

# Mapbox access token (needed from M1, for routing and geocoding).
MAPBOX_TOKEN=

# Supabase (needed from M3). The service role key bypasses Row Level Security,
# so it belongs only in the API's environment, never in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Booking.com affiliate id (needed from M4). Hotel links work without it.
BOOKING_AFFILIATE_ID=
