{
  "name": "@xnovit/api",
  "version": "0.1.0",
  "private": true,
  "description": "xNovit HTTP API (Express, TypeScript). Validates every input with @xnovit/core schemas.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@xnovit/core": "^0.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
